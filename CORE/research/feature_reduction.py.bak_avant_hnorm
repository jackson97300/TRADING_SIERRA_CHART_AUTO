FACTEUR_HORLOGE = 2.0

# Une binaire qui se declenche moins de 2 % ou plus de 98 % du temps ne
# discrimine plus rien ; entre les deux, elle porte de l'information.
BINAIRE_MIN = 0.02
BINAIRE_MAX = 0.98

